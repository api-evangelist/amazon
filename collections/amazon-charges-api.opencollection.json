{
  "opencollection": "1.0.0",
  "info": {
    "name": "Amazon Advertising Ad Groups Charges API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Charges",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Amazon Create a Charge",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://advertising-api.amazon.com/charges",
            "headers": [
              {
                "name": "x-amz-pay-date",
                "value": ""
              },
              {
                "name": "x-amz-pay-region",
                "value": ""
              },
              {
                "name": "x-amz-pay-idempotency-key",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a charge against a charge permission to authorize payment."
        },
        {
          "info": {
            "name": "Amazon Get Charge Details",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://advertising-api.amazon.com/charges/:chargeId",
            "headers": [
              {
                "name": "x-amz-pay-date",
                "value": ""
              },
              {
                "name": "x-amz-pay-region",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "chargeId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Returns details about the specified charge."
        },
        {
          "info": {
            "name": "Amazon Capture a Charge",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://advertising-api.amazon.com/charges/:chargeId/capture",
            "headers": [
              {
                "name": "x-amz-pay-date",
                "value": ""
              },
              {
                "name": "x-amz-pay-region",
                "value": ""
              },
              {
                "name": "x-amz-pay-idempotency-key",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "chargeId",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Captures a previously authorized charge."
        },
        {
          "info": {
            "name": "Amazon Cancel a Charge",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://advertising-api.amazon.com/charges/:chargeId/cancel",
            "headers": [
              {
                "name": "x-amz-pay-date",
                "value": ""
              },
              {
                "name": "x-amz-pay-region",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "chargeId",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Cancels a previously authorized charge."
        }
      ]
    }
  ],
  "bundled": true
}