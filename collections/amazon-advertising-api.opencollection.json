    {
      "info": {
        "name": "Targets",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Amazon List Product Targets",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://advertising-api.amazon.com/v2/sp/targets",
            "headers": [
              {
                "name": "Amazon-Advertising-API-Scope",
                "value": ""
              }
