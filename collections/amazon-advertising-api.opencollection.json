          "info": {
            "name": "Amazon Create Ad Groups",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://advertising-api.amazon.com/v2/sp/adGroups",
            "headers": [
              {
                "name": "Amazon-Advertising-API-Scope",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
