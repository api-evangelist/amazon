        {
          "info": {
            "name": "Amazon Create Product Targets",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://advertising-api.amazon.com/v2/sp/targets",
            "headers": [
              {
                "name": "Amazon-Advertising-API-Scope",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates one or more product targets."
