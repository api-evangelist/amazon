    {
      "info": {
        "name": "Reports",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Amazon Request a Report",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://advertising-api.amazon.com/v2/sp/:recordType/report",
            "headers": [
              {
                "name": "Amazon-Advertising-API-Scope",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "recordType",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Requests the creation of a performance report for the specified record type."
        },
        {
          "info": {
            "name": "Amazon Get Report Status",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://advertising-api.amazon.com/v2/reports/:reportId",
            "headers": [
              {
                "name": "Amazon-Advertising-API-Scope",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "reportId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Returns the status and download location of a previously requested report."
        }
      ]
    }
  ],
  "bundled": true
}